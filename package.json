{
  "name": "appium_mobile_automation_belajarbareng",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test:mobile": "wdio run ./wdio.conf.js",
    "test:sequence": "wdio run ./wdio.conf.js --spec ./test/specs/full_test_sequence.spec.js",
    "test:e2e": "wdio run ./wdio.conf.js --spec ./test/specs/e2e_register_login_post.spec.js",
    "test:positive": "wdio run ./wdio.conf.js --spec ./test/specs/positive/**/*.js",
    "test:negative": "wdio run ./wdio.conf.js --spec ./test/specs/negative/**/*.js",
    "test:login:manual": "wdio run ./wdio.conf.js --spec ./test/specs/positive/login_positive.spec.js",
    "test:login:negative": "wdio run ./wdio.conf.js --spec ./test/specs/negative/login_negative.spec.js",
    "test:register:positive": "wdio run ./wdio.conf.js --spec ./test/specs/positive/register_positive.spec.js",
    "test:register:negative": "wdio run ./wdio.conf.js --spec ./test/specs/negative/register_negative.spec.js",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "report": "npm run allure:generate && npm run allure:open"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@wdio/allure-reporter": "^9.31.5",
    "@wdio/appium-service": "^9.31.5",
    "@wdio/cli": "^9.31.5",
    "@wdio/local-runner": "^9.31.5",
    "@wdio/mocha-framework": "^9.31.5",
    "@wdio/spec-reporter": "^9.31.2",
    "allure-commandline": "^2.32.0",
    "appium": "^3.7.0"
  }
}
