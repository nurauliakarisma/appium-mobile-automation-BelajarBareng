{
  "name": "appium_mobile_automation_belajarbareng",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test:all": "wdio run ./wdio.conf.js",
    "test:e2e": "wdio run ./wdio.conf.js --spec ./test/specs/e2e/e2e_flow.spec.js",
    "test:auth": "wdio run ./wdio.conf.js --spec ./test/specs/auth/**/*.spec.js",
    "test:login": "wdio run ./wdio.conf.js --spec ./test/specs/auth/login.spec.js",
    "test:register": "wdio run ./wdio.conf.js --spec ./test/specs/auth/register.spec.js",
    "test:post": "wdio run ./wdio.conf.js --spec ./test/specs/post/post.spec.js",
    "allure:prepare": "node scripts/prepare_allure.js",
    "allure:generate": "npm run allure:prepare && allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "report": "npm run allure:generate && npm run allure:open"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@wdio/allure-reporter": "^9.31.5",
    "@wdio/appium-service": "^9.31.5",
    "@wdio/cli": "^9.31.5",
    "@wdio/local-runner": "^9.31.5",
    "@wdio/mocha-framework": "^9.31.5",
    "@wdio/spec-reporter": "^9.31.2",
    "allure-commandline": "^2.32.0",
    "appium": "^3.7.0"
  }
}
